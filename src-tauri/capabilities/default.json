{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the tray popup and Kova Editor windows",
  "windows": [
    "main",
    "tray",
    "editor-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:webview:allow-set-webview-zoom"
  ]
}
